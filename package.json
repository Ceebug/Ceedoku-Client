{
  "name": "ceedoku-client",
  "version": "1.0.1",
  "description": "Ceedoku Client",
  "author": "Ceebug",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "build": {
    "appId": "au.ceebug.ceedoku",
    "productName": "Ceedoku Client",

    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32",
          "arm64"
        ]
      },
      "icon": "assets/ceedoku.ico"
    },

    "linux": {
      "target": {
        "target": "AppImage",
        "arch": [
          "x64",
          "arm64",
          "armv7l"
        ]
      },
      "icon": "assets/ceedoku.png",
      "category": "Game"
    },

    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "icon": "assets/ceedoku.png",
      "category": "public.app-category.games"
    },

    "nsis": {
      "shortcutName": "Ceedoku",
      "artifactName": "Ceedoku Installer ${version} ${arch}.${ext}",
      "include": "installer.nsh"
    },

    "fileAssociations": [
      {
        "ext": "csf",
        "name": "Ceedoku Save File",
        "description": "Ceedoku Save File",
        "role": "Editor",
        "icon": "assets/csf.ico"
      }
    ]
  }
}
